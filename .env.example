# Optional Compose settings. Most users can enter model settings in the page.
# Copy to a private file and pass docker compose --env-file /path/to/file.
SEAMPACT_PORT=8880
# Set UID/GID to the account that owns the mounted directories on Linux.
SEAMPACT_UID=1000
SEAMPACT_GID=1000
# Optional absolute paths; defaults are var/prototype and harnesses in this repo.
# SEAMPACT_DATA_DIR=/srv/seampact/platform-state
# SEAMPACT_HARNESS_DIR=/srv/seampact/harnesses

# Optional automatic Docker backend; only deploy/compose.tools.yaml reads these.
# Build the core and tools images separately, then start with --no-build.
# Socket access lets the platform control the selected Docker daemon.
# SEAMPACT_TOOLS_IMAGE=seampact-core:source-revision-tools
# Read the local Unix socket path from the selected Docker context; do not guess.
# DOCKER_SOCKET_PATH=/var/run/docker.sock
# SEAMPACT_DOCKER_GID=0
# SEAMPACT_RUNTIME_NETWORK=seampact-runtime

# Optional keys; role keys correspond to separately configured model roles.
DEEPSEEK_API_KEY=
GLM_API_KEY=
MOONSHOT_API_KEY=
SEAMPACT_CHAT_API_KEY=
SEAMPACT_ANALYSIS_API_KEY=
