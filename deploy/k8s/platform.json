{
  "apiVersion": "v1", "kind": "List", "items": [
    {"apiVersion": "v1", "kind": "Namespace", "metadata": {"name": "seampact"}},
    {
      "apiVersion": "apps/v1", "kind": "Deployment", "metadata": {"name": "seampact-platform", "namespace": "seampact"},
      "spec": {"replicas": 1, "strategy": {"type": "Recreate"}, "selector": {"matchLabels": {"app": "seampact-platform"}},
        "template": {"metadata": {"labels": {"app": "seampact-platform"}}, "spec": {
          "securityContext": {"runAsUser": 1000, "runAsGroup": 1000},
          "containers": [{"name": "platform", "image": "seampact-core:local", "imagePullPolicy": "IfNotPresent",
            "ports": [{"containerPort": 8880}], "volumeMounts": [{"name": "state", "mountPath": "/data"}, {"name": "sources", "mountPath": "/harnesses"}]}],
          "volumes": [
            {"name": "state", "hostPath": {"path": "/srv/seampact/seampact-data", "type": "Directory"}},
            {"name": "sources", "hostPath": {"path": "/srv/seampact/harnesses", "type": "Directory"}}
          ]
        }}
      }
    },
    {"apiVersion": "v1", "kind": "Service", "metadata": {"name": "seampact-platform", "namespace": "seampact"},
      "spec": {"selector": {"app": "seampact-platform"}, "ports": [{"port": 8880, "targetPort": 8880}]}}
  ]
}
